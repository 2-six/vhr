<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.vhr.mapper.MenuMapper">

    <resultMap id="MenuMap" type="com.example.vhr.entity.Menu">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="path" property="path"/>
        <result column="component" property="component"/>
        <result column="icon" property="icon"/>
        <result column="parent_id" property="parentId"/>
        <collection property="roles" ofType="com.example.vhr.entity.Role">
            <id column="rid" property="id"/>
            <result column="rname" property="name"/>
        </collection>
    </resultMap>

    <select id="getMenusByUserId" resultMap="MenuMap">
        SELECT DISTINCT
        m.*,
        r.id AS rid,
        r.name AS rname
        FROM menu m
        LEFT JOIN role_menu rm ON m.id = rm.mid
        LEFT JOIN role r ON rm.rid = r.id
        WHERE r.id IN (
        SELECT rid FROM hr_role WHERE hr_id = #{userId}
        )
    </select>
</mapper>